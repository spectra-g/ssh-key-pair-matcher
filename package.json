{
  "name": "ssh-key-pair-matcher",
  "version": "0.0.0",
  "private": true,
  "description": "Check whether an SSH public key and OpenSSH private key belong to the same pair, entirely in the browser.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "22.16.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test --grep @browser",
    "test:a11y": "npm run build && playwright test --grep @a11y",
    "test:privacy": "npm run build && playwright test --grep @privacy",
    "test:lighthouse": "npm run build && lhci autorun",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run build",
    "verify": "npm run check && npm run test:e2e && npm run test:a11y && npm run test:privacy && npm run test:lighthouse"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.62.0",
    "@types/node": "22.20.0",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.0",
    "jsdom": "27.4.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@noble/hashes": "2.2.0"
  }
}
